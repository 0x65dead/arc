# Leave unset. `src/lib/indexer.ts` then builds same-origin `/api/v1/*` URLs,
# which the Vite dev proxy forwards to the local indexer and the `vercel.json`
# rewrite forwards to the production one. Setting it to an absolute origin makes
# the browser call that host directly instead — which skips both, turns every
# request cross-origin, and (in dev) silently talks to production.
# VITE_INDEXER_API_URL=

VITE_ALCHEMY_API_KEY=alch_pcOBNMyhx5S5sLmUmtu89

# WalletConnect project ID — free from https://cloud.reown.com
# Replace the placeholder to enable Rainbow / WalletConnect / OKX / Bitget /
# Trust and desktop QR-code connections. See .env.example for detail.
VITE_WALLETCONNECT_PROJECT_ID=YOUR_PROJECT_ID_HERE
 VITE_WALLETCONNECT_PROJECT_ID=2b3d948d23fd2f655329c3c28a413bdf
