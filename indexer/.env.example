# ---------------------------------------------------------------------------
# Copy to .env and fill in. Nothing here is a real credential.
# ---------------------------------------------------------------------------

# Postgres connection string (Supabase, Neon, RDS, local — anything).
#
# The role must be able to CREATE in the schema it uses. On Postgres 15+ that
# is not automatic: CREATE on `public` was revoked from PUBLIC, so a role that
# merely owns nothing gets "permission denied for schema public" on the first
# migration. The cleanest grant is to let the app own its own database:
#
#   CREATE ROLE arc LOGIN PASSWORD '...';
#   CREATE DATABASE arc_indexer OWNER arc;
#
# For a database you cannot re-own (a managed instance, a shared cluster):
#
#   GRANT USAGE, CREATE ON SCHEMA public TO arc;
DATABASE_URL=postgres://user:password@localhost:5432/arc_indexer

# ---------------------------------------------------------------------------
# RPC endpoints for Arc Testnet (chain id 5042002).
#
# HTTP is required: it serves the backfill, the block-timestamp lookups and the
# `listingCurrency` reads.
#
# WS is optional. With it, new logs arrive by subscription; without it the
# indexer polls every POLL_INTERVAL_SECONDS instead. Both are correct — the
# websocket is only lower-latency.
# ---------------------------------------------------------------------------
RPC_HTTP_URL=https://arc-testnet.g.alchemy.com/v2/YOUR_API_KEY_HERE
RPC_WS_URL=wss://arc-testnet.g.alchemy.com/v2/YOUR_API_KEY_HERE

# Deployed ERC1967 proxy addresses. Only proxies — never an implementation.
CONTROLLER_ADDRESS=0x2FE2560B2FE6D54e50806F531223247CcfEd739B
REGISTRAR_ADDRESS=0x3dC38247c4f9672B2C98aCfdc5C1302f8d897E9C
MARKET_ADDRESS=0xC94Ff1964840BdF8E6952455a2342Ffc6B0bA299

# Block the contracts were deployed at — where a backfill starts when no
# checkpoint exists yet.
DEPLOY_BLOCK=52346600

# ---------------------------------------------------------------------------
# Ingestion tuning (all optional; defaults shown)
# ---------------------------------------------------------------------------

# Blocks to stay behind the head before a range is treated as final and
# checkpointed. A reorg shallower than this is absorbed by the next reconcile
# pass instead of leaving rows for logs that no longer exist.
CONFIRMATIONS=5

# Blocks per eth_getLogs call. Lowered automatically if the provider advertises
# a smaller cap. Some free tiers cap at 2000-5000.
BACKFILL_CHUNK_SIZE=10000

# How often to re-read from each checkpoint to the safe head.
RECONCILE_INTERVAL_SECONDS=300

# Poll interval used only when RPC_WS_URL is unset.
POLL_INTERVAL_SECONDS=15

# Blockscout instance used as the primary log source (falls back to RPC).
ARCSCAN_API_URL=https://testnet.arcscan.app

# Per-request timeout for Blockscout. A busy address on a public instance can
# take well over 15s to answer the first page of a full-history walk, and an
# abort there throws away the whole pull in favour of a much slower RPC scan.
BLOCKSCOUT_TIMEOUT_MS=30000

# After a stream fails against Blockscout, skip it for this long and go
# straight to RPC. 0 disables the backoff and retries Blockscout every pass.
BLOCKSCOUT_COOLDOWN_SECONDS=900

# How far behind the head /api/v1/sync-status may be before reporting unhealthy.
#
# Leave unset. The default derives from RECONCILE_INTERVAL_SECONDS and Arc's
# ~0.5s block time, because a batch indexer is *expected* to sit up to one
# reconcile interval behind the head — that is how it works, not a fault. At a
# 300s interval Arc produces ~630 blocks of normal drift, so a hardcoded 200
# would report a perfectly healthy service as unhealthy, permanently.
# Only set this if you have measured a threshold you prefer.
# STALE_AFTER_BLOCKS=

# ---------------------------------------------------------------------------
# HTTP server (all optional; defaults shown)
# ---------------------------------------------------------------------------

PORT=8787
HOST=0.0.0.0

# Comma-separated allowed origins, or * for any. This API serves public chain
# data and has no authentication, so * is not a leak — but a deployment can
# lock it down to its own frontend.
CORS_ORIGINS=*

# debug | info | warn | error
LOG_LEVEL=info

# Set to `json` for a machine-parsable log stream.
LOG_FORMAT=

# Maximum Postgres connections held by this process.
DB_POOL_MAX=10
