# Postgres connection string (Supabase, Neon, RDS, local — anything)
DATABASE_URL=postgres://user:password@localhost:5432/arc_indexer

# Alchemy (or any provider) endpoints for Arc Testnet.
# HTTP is used for the one-time/catch-up backfill (chunked getLogs).
# WSS is used for the live listener (eth_subscribe on Transfer/NameRegistered/etc).
ALCHEMY_HTTP_URL=https://arc-testnet.g.alchemy.com/v2/eFsKKHfuX3iaJIWNAe27ya6FcwDnX6ZO
ALCHEMY_WSS_URL=wss://arc-testnet.g.alchemy.com/v2/eFsKKHfuX3iaJIWNAe27ya6FcwDnX6ZO

# Same deployment addresses already hardcoded in the frontend.
CONTROLLER_ADDRESS=0x2FE2560B2FE6D54e50806F531223247CcfEd739B
REGISTRAR_ADDRESS=0x3dC38247c4f9672B2C98aCfdc5C1302f8d897E9C
MARKET_ADDRESS=0xC94Ff1964840BdF8E6952455a2342Ffc6B0bA299

# Block the controller was deployed at — backfill's starting point when
# sync_state has no checkpoint yet.
DEPLOY_BLOCK=52346600

# How many blocks per getLogs() call during backfill. Lower this if your
# provider still rejects ranges at 10000 (some free tiers cap at 2000-5000).
BACKFILL_CHUNK_SIZE=10000

# Port the Express API listens on. The frontend's VITE_INDEXER_API_URL
# should point at wherever this ends up deployed (e.g. https://api.yourapp.com).
PORT=8787
